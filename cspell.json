{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "allowCompoundWords": true,
  "files": [
    "**/*.{cs,md,json,jsonc,props,yml,yaml,sh,bats}"
  ],
  "words": [
    "AOTs",
    "Cocona",
    "ECONNREFUSED",
    "ENOTSOCK",
    "Kestrel",
    "Pkcs",
    "Roslynator",
    "SYSLIB",
    "Syscall",
    "setuid",
    "VSTHRD",
    "actionlint",
    "allowlist",
    "allowlisted",
    "blittable",
    "buildx",
    "containerenv",
    "coverlet",
    "deconfigure",
    "distros",
    "dotnet",
    "errno",
    "geteuid",
    "healthz",
    "libc",
    "mandoc",
    "markdownlint",
    "nfpm",
    "nlink",
    "nuget",
    "pkill",
    "shellcheck",
    "shfmt",
    "slnx",
    "sockaddr",
    "sysexits",
    "tmpfs",
    "trixie",
    "unconfigurable",
    "unconfigured",
    "unmapped",
    "unrepresentable",
    "unsets",
    "xunit"
  ],
  "ignorePaths": [
    ".git/**",
    ".scratch/**",
    "artifacts/**",
    "**/packages.lock.json"
  ]
}

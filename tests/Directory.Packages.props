<Project>

  <!--
    MSBuild reads the nearest Directory.Packages.props and does not merge outward,
    so the repo-wide policy has to be imported rather than inherited.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="3.1.0" />
  </ItemGroup>

</Project>
